# Copy to .env for local runs. Never commit .env. On Render, set these in the dashboard.

# PayPal REST app (developer.paypal.com > Apps & Credentials > Sandbox). Leave empty for MOCK mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID for payout status events (polling works without it).
PAYPAL_WEBHOOK_ID=
# sandbox | mock (live is refused)
PAYPAL_MODE=sandbox

# Sandbox personal accounts that receive payouts in the demo: Name=email,Name=email
DEMO_PAYOUT_RECEIVERS=Bob=,Carol=,Dave=

# Ed25519 secret key (64 hex chars) that signs offline load certificates.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_SECRET_KEY=

# Claude settlement agent. Leave empty for rule-based fallback.
# Set ONE key. OpenRouter wins if both are set. Empty LLM_MODEL = the right default for the key.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_EFFORT=low
LLM_RUNS_PER_DAY=300

# Payouts above this need a human (cents).
APPROVAL_LIMIT_CENTS=2500
MAX_LOAD_CENTS=10000
PORT=8787
