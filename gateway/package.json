{
  "name": "@meshtab/gateway",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --external:express --external:@anthropic-ai/sdk --external:@paypal/agent-toolkit --external:zod-to-json-schema --external:zod",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@meshtab/agent": "*",
    "@meshtab/protocol": "*",
    "express": "^5.3.0"
  }
}
